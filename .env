# Copy to ".env" (same folder as docker-compose.yml) and fill in real values.
# docker compose reads this automatically - do not commit the real ".env".

# --- PostgreSQL ---
DB_USER=shopeasy_user
DB_PASSWORD=change_me_strong_password
DB_NAME=shopeasy

# --- Redis ---
REDIS_PASSWORD=change_me_redis_password

# --- Image naming (used when building/pushing locally) ---
# Your Docker Hub username/org - images are pushed as:
#   <DOCKERHUB_USERNAME>/shopeasy-backend:<IMAGE_TAG>
#   <DOCKERHUB_USERNAME>/shopeasy-frontend:<IMAGE_TAG>
DOCKERHUB_USERNAME=oluwademilade
IMAGE_TAG=latest
